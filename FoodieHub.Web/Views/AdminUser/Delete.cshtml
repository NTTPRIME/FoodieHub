@* Khai báo kiểu dữ liệu Model liên kết với View là đối tượng User cần xác nhận xóa *@
@model FoodieHub.Web.Models.User

@{
    @* Thiết lập tiêu đề trang hiển thị trên thẻ tab của trình duyệt *@
    ViewBag.Title = "Xác nhận xóa tài khoản Admin";
    @* Chỉ định sử dụng khung giao diện trang quản trị _AdminLayout.cshtml *@
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@* Tiêu đề chính trang xác nhận xóa tài khoản người dùng Admin *@
<h2 class="mt-4 mb-3 text-danger fw-bold">Xác nhận xóa người dùng Admin</h2>

@* Kiểm tra nếu có thông báo lỗi từ Controller truyền qua ViewBag.Error *@
@if (ViewBag.Error != null)
{
    @* Thẻ khung thông báo lỗi màu đỏ *@
    <div class="alert alert-danger shadow-sm">
        @* Hiển thị icon cảnh báo kèm nội dung tin nhắn lỗi *@
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
    </div>
}

@* Thẻ Card Bootstrap tạo khung bao quanh thông tin tài khoản sắp xóa *@
<div class="card shadow p-4 mb-4 border-danger">
    @* Câu hỏi xác nhận hành động xóa tài khoản *@
    <h4 class="card-title text-danger border-bottom pb-2">Bạn có chắc chắn muốn xóa tài khoản người dùng này?</h4>

    @* Danh sách mô tả hiển thị chi tiết thông tin tài khoản *@
    <dl class="row mt-3">
        @* Nhãn Mã số người dùng *@
        <dt class="col-sm-3">Mã số:</dt>
        @* Giá trị mã định danh UserID *@
        <dd class="col-sm-9">@Model.UserID</dd>

        @* Nhãn Họ và tên người dùng *@
        <dt class="col-sm-3">Họ và tên:</dt>
        @* Giá trị Họ và tên in đậm *@
        <dd class="col-sm-9 fw-bold text-primary">@Model.FullName</dd>

        @* Nhãn Địa chỉ Email *@
        <dt class="col-sm-3">Địa chỉ Email:</dt>
        @* Giá trị địa chỉ Email đăng nhập *@
        <dd class="col-sm-9">@Model.Email</dd>
    </dl>

    @* Form gửi dữ liệu POST về Action Delete trong AdminUserController (Barem Dòng 21) *@
    @using (Html.BeginForm("Delete", "AdminUser", new { id = Model.UserID }, FormMethod.Post))
    {
        @* Mã hóa xác thực chống tấn công giả mạo yêu cầu chéo trang CSRF *@
        @Html.AntiForgeryToken()

        @* Khung chứa các nút bấm xác nhận hoặc hủy thao tác *@
        <div class="mt-3">
            @* Nút kích hoạt lệnh xóa tài khoản người dùng khỏi cơ sở dữ liệu *@
            <button type="submit" class="btn btn-danger" onclick="return confirm('Xác nhận xóa vĩnh viễn tài khoản người dùng này?');">
                @* Biểu tượng thùng rác xóa *@
                <i class="bi bi-trash"></i> Xác nhận xóa
            </button>
            @* Nút Hủy và quay lại trang danh sách người dùng *@
            <a href="@Url.Action("Index", "AdminUser")" class="btn btn-secondary ms-2">
                Hủy & Quay lại
            </a>
        </div>
    }
</div>
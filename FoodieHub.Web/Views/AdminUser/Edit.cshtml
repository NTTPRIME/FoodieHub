@* Khai báo kiểu dữ liệu Model liên kết với View là đối tượng User *@
@model FoodieHub.Web.Models.User

@{
    @* Thiết lập tiêu đề trang hiển thị trên thẻ tab trình duyệt *@
    ViewBag.Title = "Chỉnh sửa người dùng Admin";
    @* Chỉ định sử dụng khung giao diện trang quản trị _AdminLayout.cshtml *@
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@* Tiêu đề chính của trang chỉnh sửa tài khoản người dùng Admin *@
<h2 class="mt-4 mb-3 text-warning fw-bold">Chỉnh sửa tài khoản Admin</h2>

@* Kiểm tra nếu có thông báo lỗi từ Controller truyền sang ViewBag.Error *@
@if (ViewBag.Error != null)
{
    @* Thẻ khung thông báo màu đỏ hiển thị thông điệp cảnh báo lỗi *@
    <div class="alert alert-danger shadow-sm">
        @* Biểu tượng cảnh báo kèm văn bản thông báo lỗi *@
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
    </div>
}

@* Tạo Form gửi dữ liệu phương thức POST tới Action Edit trong AdminUserController *@
@using (Html.BeginForm("Edit", "AdminUser", FormMethod.Post))
{
    @* Tạo mã Token xác thực chống tấn công giả mạo CSRF *@
    @Html.AntiForgeryToken()

    @* Trường ẩn lưu giữ khóa chính UserID để gửi về Server khi Submit *@
    @Html.HiddenFor(model => model.UserID)

    @* Thẻ Card Bootstrap tạo khung bao quanh Form chỉnh sửa *@
    <div class="card shadow p-4 mb-4">
        @* Hiển thị tổng hợp các thông báo lỗi kiểm tra dữ liệu nếu có *@
        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        @* Khung chỉnh sửa Họ và tên *@
        <div class="mb-3">
            @* Hiển thị nhãn tên trường Họ và tên theo cấu hình Metadata *@
            @Html.LabelFor(model => model.FullName, new { @class = "form-label fw-bold" })
            @* Ô nhập văn bản chứa Họ và tên hiện tại của người dùng *@
            @Html.TextBoxFor(model => model.FullName, new { @class = "form-control", placeholder = "Nhập họ và tên đầy đủ..." })
            @* Hiển thị thông báo lỗi màu đỏ riêng cho trường FullName *@
            @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
        </div>

        @* Khung chỉnh sửa Địa chỉ Email *@
        <div class="mb-3">
            @* Hiển thị nhãn tên trường Địa chỉ Email *@
            @Html.LabelFor(model => model.Email, new { @class = "form-label fw-bold" })
            @* Ô nhập liệu định dạng Email chứa địa chỉ Email hiện tại *@
            @Html.TextBoxFor(model => model.Email, new { @class = "form-control", type = "email", placeholder = "Nhập địa chỉ email đăng nhập..." })
            @* Hiển thị thông báo lỗi màu đỏ riêng cho trường Email *@
            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
        </div>

        @* Khung chỉnh sửa Mật khẩu *@
        <div class="mb-3">
            @* Hiển thị nhãn tên trường Mật khẩu *@
            @Html.LabelFor(model => model.Password, new { @class = "form-label fw-bold" })
            @* Ô nhập mật khẩu mới (hoặc giữ mật khẩu cũ) *@
            @Html.PasswordFor(model => model.Password, new { @class = "form-control", placeholder = "Nhập mật khẩu mới..." })
            @* Hiển thị thông báo lỗi màu đỏ riêng cho trường Password *@
            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
        </div>

        @* Khung chứa các nút bấm thao tác *@
        <div class="mt-3">
            @* Nút Submit cập nhật các thay đổi xuống CSDL *@
            <button type="submit" class="btn btn-warning">
                @* Biểu tượng bút viết chỉnh sửa *@
                <i class="bi bi-pencil-square"></i> Cập nhật thay đổi
            </button>
            @* Nút chuyển hướng quay về trang danh sách tài khoản *@
            <a href="@Url.Action("Index", "AdminUser")" class="btn btn-secondary ms-2">
                Quay lại danh sách
            </a>
        </div>
    </div>
}
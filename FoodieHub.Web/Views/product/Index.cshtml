@{
    // Thiết lập tiêu đề hiển thị trên thẻ Tab trình duyệt
    ViewBag.Title = "Thực Đơn Món Ăn - Green SM Food";

    // Nhúng giao diện này vào Master Layout chung do Dev 1 dựng
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}

<div class="container my-4">
    <!-- TIÊU ĐỀ TRANG -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <h2 class="text-success fw-bold m-0">
            <i class="fas fa-utensils me-2"></i>Thực Đơn Món Ăn
        </h2>
        <span class="badge bg-success fs-6">Đã sẵn sàng giao hàng</span>
    </div>

    <!-- KHU VỰC BỘ LỌC TÌM KIẾM MÓN ĂN -->
    <div class="card p-3 shadow-sm mb-4 border-0 bg-light">
        <div class="row g-3">
            <!-- Ô tìm kiếm tên món -->
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Nhập tên món ăn cần tìm (VD: Cơm tấm, Bún bò...)...">
                </div>
            </div>
            <!-- Dropdown chọn danh mục món -->
            <div class="col-md-4">
                <select class="form-select">
                    <option selected>-- Tất cả danh mục món --</option>
                    <option value="1">Cơm & Món chính</option>
                    <option value="2">Bún / Phở / Mì</option>
                    <option value="3">Đồ uống & Trái cây</option>
                </select>
            </div>
            <!-- Nút bấm lọc -->
            <div class="col-md-3">
                <button class="btn btn-success w-100 fw-bold">
                    <i class="fas fa-filter me-1"></i> Lọc Món Ăn
                </button>
            </div>
        </div>
    </div>

    <!-- DANH SÁCH CÁC THẺ SẢN PHẨM (MÓN ĂN) -->
    <div class="row g-4">
        <!-- MÓN 1 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                <!--
                    MẸO SỬA ẢNH LOCAL:
                    Nếu bạn dùng ảnh trong máy, hãy thay attribute src bên dưới thành:
                    src="@Url.Content("~/Content/images/com-tam.jpg")"
                -->
                <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=600&q=80"
                     class="card-img-top" alt="Cơm Tấm Sườn Bì Chả" style="height: 220px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">Cơm Tấm Sườn Bì Chả</h5>
                    <p class="card-text text-muted small flex-grow-1">Sườn nướng mật ong thơm lừng, bì giòn rụm, chả trứng béo ngậy kèm nước mắm đậm đà.</p>
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                        <span class="text-danger fw-bold fs-5">55.000đ</span>
                        <a href="@Url.Action("Detail", "Product", new { id = 1 })" class="btn btn-outline-success btn-sm fw-bold">
                            Xem chi tiết <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- MÓN 2 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1569718212165-3a8278d5f624?auto=format&fit=crop&w=600&q=80"
                     class="card-img-top" alt="Mì Ramen / Phở" style="height: 220px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">Phở Bò Đặc Biệt</h5>
                    <p class="card-text text-muted small flex-grow-1">Nước dùng hầm xương đậm đà 24h, tái nạm gầu giòn ngon kèm húng xế, giá sống tươi tắn.</p>
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                        <span class="text-danger fw-bold fs-5">65.000đ</span>
                        <a href="@Url.Action("Detail", "Product", new { id = 2 })" class="btn btn-outline-success btn-sm fw-bold">
                            Xem chi tiết <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- MÓN 3 -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=600&q=80"
                     class="card-img-top" alt="Salad Trộn" style="height: 220px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">Salad Hạt & Ức Gà</h5>
                    <p class="card-text text-muted small flex-grow-1">Món ăn Healthy dinh dưỡng cao, rau củ hữu cơ tươi ngon kết hợp sốt Mè rang thơm ngon.</p>
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                        <span class="text-danger fw-bold fs-5">49.000đ</span>
                        <a href="@Url.Action("Detail", "Product", new { id = 3 })" class="btn btn-outline-success btn-sm fw-bold">
                            Xem chi tiết <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
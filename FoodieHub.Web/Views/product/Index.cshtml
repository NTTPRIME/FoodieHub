@model IEnumerable<FoodieHub.Web.Controllers.ProductItem>

@{
    // Thiết lập tiêu đề hiển thị trên thẻ Tab trình duyệt
    ViewBag.Title = ViewBag.CategoryName ?? "Thực Đơn Món Ăn - GoFood";

    // Nhúng giao diện này vào Master Layout chung
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}

<div class="container my-4">
    <!-- TIÊU ĐỀ TRANG -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <h2 class="text-success fw-bold m-0">
            <i class="fas fa-utensils me-2"></i>@(ViewBag.CategoryName ?? "Thực Đơn Món Ăn")
        </h2>
        <span class="badge bg-success fs-6">Đã sẵn sàng giao hàng</span>
    </div>

    <!-- KHU VỰC BỘ LỌC TÌM KIẾM MÓN ĂN (Đã bọc form GET để gửi dữ liệu về Controller) -->
    <form method="get" action="@Url.Action("Index", "Product")" class="card p-3 shadow-sm mb-4 border-0 bg-light">
        <div class="row g-3">
            <!-- Ô tìm kiếm tên món -->
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="searchString" class="form-control border-start-0"
                           value="@Request.QueryString["searchString"]"
                           placeholder="Nhập tên món ăn cần tìm (VD: Cơm tấm, Bún bò...)...">
                </div>
            </div>
            <!-- Dropdown chọn danh mục món -->
            <div class="col-md-4">
                <select name="categoryId" class="form-select">
                    <option value="">-- Tất cả danh mục món --</option>
                    <option value="1" @(Request.QueryString["categoryId"] == "1" ? "selected" : "")>Cơm & Món chính</option>
                    <option value="2" @(Request.QueryString["categoryId"] == "2" ? "selected" : "")>Trà Sữa & Đồ Uống</option>
                    <option value="3" @(Request.QueryString["categoryId"] == "3" ? "selected" : "")>Bún / Phở / Mì</option>
                    <option value="4" @(Request.QueryString["categoryId"] == "4" ? "selected" : "")>Ăn Vặt & Ăn Nhẹ</option>
                </select>
            </div>
            <!-- Nút bấm lọc -->
            <div class="col-md-3">
                <button type="submit" class="btn btn-success w-100 fw-bold">
                    <i class="fas fa-filter me-1"></i> Lọc Món Ăn
                </button>
            </div>
        </div>
    </form>

    <!-- DANH SÁCH CÁC THẺ SẢN PHẨM (MÓN ĂN) ĐỘNG -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                        <!-- Hiển thị hình ảnh động của món ăn -->
                        <img src="@(!string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=600&q=80")"
                             class="card-img-top" alt="@item.ProductName" style="height: 220px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@item.ProductName</h5>
                            <p class="card-text text-muted small flex-grow-1">@item.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <span class="text-danger fw-bold fs-5">@string.Format("{0:N0}", item.Price)đ</span>
                                <a href="@Url.Action("Detail", "Product", new { id = item.ProductID })" class="btn btn-outline-success btn-sm fw-bold">
                                    Xem chi tiết <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Thông báo khi không tìm thấy kết quả -->
            <div class="col-12 text-center py-5">
                <div class="alert alert-warning py-4 shadow-sm" role="alert">
                    <i class="fas fa-exclamation-triangle fs-3 mb-2"></i><br />
                    <strong>Không tìm thấy món ăn nào phù hợp!</strong><br />
                    <span class="text-muted small">Vui lòng thử lại với từ khóa khác hoặc chọn danh mục khác.</span>
                </div>
            </div>
        }
    </div>
</div>
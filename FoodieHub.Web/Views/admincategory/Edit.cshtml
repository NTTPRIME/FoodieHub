@* Khai báo Model liên kết với View là đối tượng Category *@
@model FoodieHub.Web.Models.Category
@{
    @* Thiết lập tiêu đề hiển thị trên thanh tab trình duyệt *@
    ViewBag.Title = "Chỉnh sửa danh mục món ăn";
    @* Chỉ định sử dụng khung giao diện trang quản trị *@
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@* Khung container chứa form chỉnh sửa danh mục *@
<div class="container-fluid py-4" style="max-width: 700px;">
    @* Thẻ Card Bootstrap tạo khung hiển thị form đổ bóng *@
    <div class="card shadow border-0 rounded-3 p-4">
        @* Tiêu đề trang Chỉnh sửa danh mục *@
        <h3 class="text-center mb-4 text-warning fw-bold">
            @* Biểu tượng bút sửa *@
            <i class="fa-solid fa-pen-to-square me-2"></i>CHỈNH SỬA DANH MỤC MÓN ĂN
        </h3>
        @* Tạo Form HTML Helper gửi dữ liệu phương thức POST về Action Edit *@
        @using (Html.BeginForm("Edit", "AdminCategory", FormMethod.Post))
        {
            @* Mã xác thực CSRF Token chống tấn công chéo trang *@
            @Html.AntiForgeryToken()
            @* Trường ẩn lưu giữ khóa chính CategoryID để gửi về Controller khi Submit *@
            @Html.HiddenFor(model => model.CategoryID)
            @* Hiển thị tổng hợp các lỗi Validation dữ liệu (Barem Dòng 9) *@
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3 fw-semibold" })
            @* Khung nhập liệu Tên danh mục món ăn *@
            <div class="mb-4">
                @* Hiển thị nhãn thuộc tính Tên danh mục lấy từ Metadata *@
                @Html.LabelFor(model => model.CategoryName, new { @class = "form-label fw-bold fs-6" })
                @* Ô nhập liệu văn bản chứa Tên danh mục hiện tại *@
                @Html.TextBoxFor(model => model.CategoryName, new { @class = "form-control form-control-lg", placeholder = "Nhập tên danh mục..." })
                @* Hiển thị dòng tin nhắn báo lỗi màu đỏ riêng cho thuộc tính CategoryName *@
                @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger small mt-1 d-block" })
            </div>
            @* Khung chứa các nút hành động *@
            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                @* Nút chuyển hướng quay về lại trang danh sách danh mục *@
                <a href="@Url.Action("Index", "AdminCategory")" class="btn btn-secondary px-4 fw-semibold">
                    @* Biểu tượng mũi tên quay lại *@
                    <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                </a>
                @* Nút Submit thực hiện cập nhật thay đổi danh mục *@
                <button type="submit" class="btn btn-warning text-white px-4 fw-bold shadow-sm">
                    @* Biểu tượng dấu check hoàn tất *@
                    <i class="fa-solid fa-check me-1"></i> Cập nhật thay đổi
                </button>
            </div>
        }
    </div>
</div>
@model dynamic /* Hoặc kiểu model thực tế của bảng User, ví dụ: @model FoodieHub.Web.Models.User */

@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; /* Hoặc layout chung của trang */
}

<div class="container-fluid px-4">
    <h2 class="mt-4">Hồ sơ cá nhân</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ và tên:</label>
                        <p class="form-control-static">@(Session["FullName"] ?? Model.FullName)</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email:</label>
                        <p class="form-control-static">@(Session["UserEmail"] ?? Model.Email)</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Vai trò hệ thống:</label>
                        <p class="form-control-static">
                            @if (Session["UserRole"] != null && Session["UserRole"].ToString() == "Admin")
                            {
                                <span class="badge bg-success">Quản trị viên (Admin)</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Khách hàng</span>
                            }
                        </p>
                    </div>
                    <a href="@Url.Action("Index", "AdminProduct")" class="btn btn-secondary">Quay lại trang quản trị</a>
                </div>
            </div>
        </div>
    </div>
</div>
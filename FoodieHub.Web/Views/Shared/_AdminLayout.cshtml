<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin GoFood</title>
    <!-- Nhúng Bootstrap CSS từ CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Nhúng FontAwesome cho icon menu --> 
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            font-size: 0.9rem;
            background-color: #f8f9fa;
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            background-color: #212529;
            color: #fff;
            flex-shrink: 0;
        }

            .sidebar .nav-link {
                color: #adb5bd;
                padding: 12px 20px;
                transition: 0.2s;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    color: #fff;
                    background-color: #ff6b6b;
                }

        .main-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            height: 60px;
            background: #fff;
            border-bottom: 1px solid #dee2e6;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 0 20px;
        }

        .content-body {
            padding: 20px;
            flex-grow: 1;
        }
    </style>
</head>
<body>
    <div class="admin-wrapper">
        <!-- BEGIN: Sidebar Quản trị bên trái -->
        <nav class="sidebar d-flex flex-column p-3">
            <h4 class="text-white text-center py-3"><i class="fa-solid fa-utensils"></i> Admin Panel</h4>
            <hr class="text-secondary">
            <!-- THAY THẾ KHỐI <ul> BÊN DƯỚI BẰNG ĐOẠN NÀY: -->
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item mb-1">
                    <a href="/AdminCategory/Index" class="nav-link"><i class="fa-solid fa-chart-line me-2"></i> Dashboard</a>
                </li>
                <li class="nav-item mb-1">
                    <a href="/AdminCategory/Index" class="nav-link"><i class="fa-solid fa-list me-2"></i> Quản lý danh mục</a>
                </li>
                <li class="nav-item mb-1">
                    <a href="/AdminProduct/Index" class="nav-link"><i class="fa-solid fa-burger me-2"></i> Quản lý hàng hóa</a>
                </li>
                <li class="nav-item mb-1">
                    <a href="/AdminWarehouse/Index" class="nav-link"><i class="fa-solid fa-warehouse me-2"></i> Quản lý kho hàng</a>
                </li>
                <li class="nav-item mb-1">
                    <a href="/AdminCustomer/Index" class="nav-link"><i class="fa-solid fa-user-group me-2"></i> Quản lý khách hàng</a>
                </li>
                <li class="nav-item mb-1">
                    <a href="/AdminOrder/Index" class="nav-link"><i class="fa-solid fa-receipt me-2"></i> Quản lý đơn hàng</a>
                </li>
            </ul>
            <!-- END KHỐI <ul> -->
        </nav>
        <!-- END: Sidebar -->
        <!-- BEGIN: Main Content Area -->
        <div class="main-content">
            <!-- Topbar phía trên -->
            <header class="topbar">
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle" id="adminDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa-solid fa-circle-user fs-4 me-2"></i> <strong>Admin Hệ Thống</strong>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end text-small shadow" aria-labelledby="adminDropdown">
                        <li><a class="dropdown-item" href="#">Hồ sơ cá nhân</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="#">Đăng xuất</a></li>
                    </ul>
                </div>
            </header>
            <!-- Nơi render nội dung View con của Admin -->
            <div class="content-body">
                @RenderBody()
            </div>
        </div>
        <!-- END: Main Content -->
    </div>

    <!-- Nhúng Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - FoodieHub Đặt Món Trực Tuyến</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    <!-- HEADER STYLED GO FOOD -->
    <header class="bg-white border-bottom sticky-top shadow-sm">
        <div class="container d-flex align-items-center justify-content-between py-2">
            <!-- Logo Thương hiệu -->
            <a href="@Url.Action("Index", "Home")" class="text-decoration-none fs-3 fw-bold text-danger">
                Foodie<span class="text-dark">Hub</span>
            </a>

            <!-- Thanh tìm kiếm món ăn -->
            <div class="w-50">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Tìm món ăn, cơm tấm, trà sữa, phở..." />
                    <button class="btn btn-foodie" type="button">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </div>

            <!-- Cụm Giỏ hàng & Nút Đăng nhập -->
            <div class="d-flex align-items-center gap-3">
                <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-foodie position-relative">
                    <i class="fa-solid fa-cart-shopping fs-5"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill badge-cart">
                        0
                    </span>
                </a>
                <a href="@Url.Action("Login", "Account")" class="btn btn-foodie">
                    <i class="fa-solid fa-user me-1"></i> Đăng Nhập
                </a>
            </div>
        </div>
    </header>

    <!-- NỘI DUNG CHÍNH ĐỔ VÀO ĐÂY -->
    <main class="container my-4">
        @RenderBody()
    </main>

    <!-- FOOTER CHUẨN F&B -->
    <footer class="bg-white border-top py-4 mt-5 text-center text-muted">
        <div class="container">
            <p class="mb-1 fw-semibold text-dark">FoodieHub - Sàn Thương Mại Điện Tử Ẩm Thực Trực Tuyến</p>
            <small>&copy; @DateTime.Now.Year FoodieHub Platform. All rights reserved.</small>
        </div>
    </footer>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
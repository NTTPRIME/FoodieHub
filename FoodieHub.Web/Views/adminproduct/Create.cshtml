@* Khai báo kiểu dữ liệu Model truyền vào View là đối tượng sản phẩm Product *@
@model FoodieHub.Web.Models.Product

@{
    @* Thiết lập tiêu đề trang hiển thị trên thẻ tab trình duyệt *@
    ViewBag.Title = "Thêm mới món ăn";
    @* Chỉ định sử dụng khung giao diện trang quản trị _AdminLayout.cshtml *@
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@* Khung bọc toàn bộ giao diện thêm mới sản phẩm *@
<div class="container-fluid mt-3">
    @* Tiêu đề trang thêm mới món ăn *@
    <h2 class="fw-bold text-dark mb-4">
        @* Biểu tượng dấu cộng thêm mới *@
        <i class="fa-solid fa-plus-circle text-danger me-2"></i>Thêm Mới Món Ăn
    </h2>

    @* Mở Form HTML Helper hỗ trợ Upload File (enctype = multipart/form-data) gửi về Action Create (Barem Dòng 15, 16) *@
    @using (Html.BeginForm("Create", "AdminProduct", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @* Tạo mã xác thực chống tấn công giả mạo yêu cầu chéo trang (CSRF Token) *@
        @Html.AntiForgeryToken()

        @* Thẻ Card Bootstrap tạo khung bao quanh form nhập liệu *@
        <div class="card shadow-sm border-0 p-4">
            @* Hiển thị tổng hợp các thông báo lỗi Validation nếu dữ liệu gửi lên không thỏa mãn *@
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3 fw-bold" })

            @* Khung nhập liệu Tên món ăn *@
            <div class="mb-3">
                @* Nhãn hiển thị tên trường Tên món ăn theo Data Annotation ở Metadata *@
                @Html.LabelFor(model => model.ProductName, new { @class = "form-label fw-bold" })
                @* Ô nhập liệu văn bản cho Tên món ăn *@
                @Html.TextBoxFor(model => model.ProductName, new { @class = "form-control", placeholder = "Nhập tên món ăn (VD: Gà Rán Sốt Cay...)" })
                @* Hiển thị dòng tin nhắn báo lỗi đỏ riêng cho thuộc tính ProductName *@
                @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger small" })
            </div>

            @* Khung chọn Danh mục món ăn *@
            <div class="mb-3">
                @* Nhãn hiển thị tên trường Danh mục món ăn *@
                @Html.LabelFor(model => model.CategoryID, new { @class = "form-label fw-bold" })
                @* DropdownList danh sách danh mục được nạp từ ViewBag.CategoryID bên Controller *@
                @Html.DropDownList("CategoryID", null, "-- Chọn danh mục món ăn --", new { @class = "form-select" })
                @* Hiển thị dòng tin nhắn báo lỗi đỏ riêng cho thuộc tính CategoryID *@
                @Html.ValidationMessageFor(model => model.CategoryID, "", new { @class = "text-danger small" })
            </div>

            @* Khung nhập liệu Giá bán *@
            <div class="mb-3">
                @* Nhãn hiển thị tên trường Giá bán *@
                @Html.LabelFor(model => model.Price, new { @class = "form-label fw-bold" })
                @* Ô nhập liệu kiểu số cho Giá bán sản phẩm *@
                @Html.TextBoxFor(model => model.Price, new { @class = "form-control", type = "number", min = "0", placeholder = "Nhập giá bán (VD: 45000)..." })
                @* Hiển thị dòng tin nhắn báo lỗi đỏ riêng cho thuộc tính Price *@
                @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger small" })
            </div>

            @* Khung nhập liệu Số lượng tồn kho *@
            <div class="mb-3">
                @* Nhãn hiển thị tên trường Số lượng tồn kho *@
                @Html.LabelFor(model => model.Stock, new { @class = "form-label fw-bold" })
                @* Ô nhập liệu kiểu số cho Số lượng tồn kho *@
                @Html.TextBoxFor(model => model.Stock, new { @class = "form-control", type = "number", min = "0", placeholder = "Nhập số lượng tồn kho (VD: 100)..." })
                @* Hiển thị dòng tin nhắn báo lỗi đỏ riêng cho thuộc tính Stock *@
                @Html.ValidationMessageFor(model => model.Stock, "", new { @class = "text-danger small" })
            </div>

            @* Khung tải lên tệp hình ảnh sản phẩm (Barem Dòng 16) *@
            <div class="mb-3">
                @* Nhãn chọn file hình ảnh *@
                <label class="form-label fw-bold" for="ImageFile">Hình ảnh món ăn (*)</label>
                @* Thẻ input chọn tệp ảnh từ máy tính gửi qua tham số ImageFile *@
                <input type="file" name="ImageFile" id="imageInput" class="form-control" accept="image/*" />
            </div>

            @* Khung xem trước hình ảnh trước khi thực hiện bấm Lưu (Image Preview JS) *@
            <div class="mb-3 text-center">
                @* Thẻ img hiển thị ảnh xem trước, mặc định ẩn bằng d-none *@
                <img id="imagePreview" src="#" alt="Xem trước hình ảnh" class="rounded border shadow-sm d-none" style="max-height: 180px; object-fit: cover;" />
            </div>

            @* Khung chứa các nút thao tác gửi Form hoặc Hủy *@
            <div class="mt-4 pt-2 border-top">
                @* Nút submit gửi dữ liệu tạo món ăn *@
                <button type="submit" class="btn btn-danger fw-bold me-2 px-4">
                    @* Biểu tượng lưu đĩa mềm *@
                    <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Món Ăn
                </button>
                @* Nút chuyển hướng quay về lại trang danh sách món ăn *@
                <a href="@Url.Action("Index", "AdminProduct")" class="btn btn-secondary px-4">
                    Quay lại danh sách
                </a>
            </div>
        </div>
    }
</div>

@* Khai báo phần kịch bản JavaScript xử lý xem trước ảnh khi người dùng chọn file *@
@section scripts {
    <script>
        // Lắng nghe sự kiện khi tài liệu DOM đã được tải hoàn tất
        $(document).ready(function () {
            // Đăng ký sự kiện thay đổi file trên thẻ input chọn ảnh #imageInput
            $('#imageInput').change(function (event) {
                // Lấy tệp tin đầu tiên trong danh sách các tệp được người dùng chọn
                var file = event.target.files[0];
                // Kiểm tra xem người dùng có chọn tệp tin hợp lệ hay không
                if (file) {
                    // Khởi tạo đối tượng FileReader để đọc tệp tin cục bộ
                    var reader = new FileReader();
                    // Đăng ký sự kiện thực thi sau khi hoàn tất đọc tệp ảnh
                    reader.onload = function (e) {
                        // Gán đường dẫn DataURL tạo được vào thuộc tính src của thẻ #imagePreview
                        $('#imagePreview').attr('src', e.target.result);
                        // Bỏ lớp d-none để hiển thị thẻ hình ảnh xem trước lên màn hình
                        $('#imagePreview').removeClass('d-none');
                    };
                    // Tiến hành đọc tệp dưới dạng DataURL
                    reader.readAsDataURL(file);
                }
            });
        });
    </script>
}
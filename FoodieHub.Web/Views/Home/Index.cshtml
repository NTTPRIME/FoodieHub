@* Khai báo Mô hình dữ liệu truyền sang View là danh sách các đối tượng Sản phẩm (Product) *@
@model IEnumerable<FoodieHub.Web.Models.Product>

@{
    // Cấu hình tiêu đề hiển thị trên thẻ tab của trình duyệt
    ViewBag.Title = "FoodieHub - Đặt Món Ngon Giao Nhanh Tận Nơi";
    // Đặt đường dẫn sử dụng file Giao diện khung chung (Master Layout)
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
    // Ép kiểu dữ liệu từ ViewBag.Categories sang danh sách List<Category> để sử dụng bên dưới
    var categories = ViewBag.Categories as List<FoodieHub.Web.Models.Category>;
}

<!-- ========================================== -->
<!-- 1. VÙNG HERO BANNER ĐẦU TRANG             -->
<!-- ========================================== -->
<!-- Khung Banner tràn lề sử dụng hiệu ứng màu chuyển Đỏ - Cam thương hiệu FoodieHub -->
<div class="p-5 mb-4 text-white rounded-3 shadow" style="background: linear-gradient(135deg, #EE4D2D, #ff7e5f) !important;">
    <!-- Khung chứa nội dung căn giữa banner -->
    <div class="container-fluid py-3 text-center">
        <!-- Tiêu đề lớn chào mừng khách hàng kèm icon ngọn lửa -->
        <h1 class="display-4 fw-bold mb-3">
            <i class="fa-solid fa-fire me-2"></i>Thỏa Sức Thưởng Thức Món Ngon Cùng FoodieHub!
        </h1>
        <!-- Lời nhắn cam kết chất lượng và thời gian giao hàng -->
        <p class="fs-5 mb-4 opacity-90">Giao hàng siêu tốc trong 20 phút - Đảm bảo nóng hổi, thơm ngon chuẩn vị gia đình.</p>
        <!-- Nút cuộn nhanh xuống phần danh sách thực đơn bên dưới -->
        <a href="#menuSection" class="btn btn-light btn-lg fw-bold text-danger rounded-pill px-4 shadow-sm">
            <i class="fa-solid fa-utensils me-2"></i>Khám Phá Thực Đơn Ngay
        </a>
    </div>
</div>

<!-- ========================================== -->
<!-- 2. VÙNG DANH MỤC MÓN ĂN NỔI BẬT            -->
<!-- ========================================== -->
<!-- Khung chứa các nút lọc danh mục sản phẩm -->
<div class="container mb-5" id="menuSection">
    <!-- Tiêu đề phần danh mục -->
    <div class="text-center mb-4">
        <h3 class="fw-bold text-uppercase text-danger">
            <i class="fa-solid fa-list-check me-2"></i>Danh Mục Món Ăn Nổi Bật
        </h3>
        <p class="text-muted">Chọn danh mục yêu thích để tìm kiếm món ăn nhanh nhất</p>
    </div>

    <!-- Hàng chứa danh sách nút danh mục căn giữa -->
    <div class="row g-3 justify-content-center">
        <!-- Nút xem tất cả sản phẩm (Mặc định) -->
        <div class="col-6 col-sm-4 col-md-2">
            <a href="@Url.Action("Index", "Product")" class="card text-center p-3 text-decoration-none shadow-sm h-100 border-0 rounded-3 bg-white text-dark">
                <div class="fs-2 text-warning mb-2"><i class="fa-solid fa-star"></i></div>
                <span class="fw-bold small">Tất Cả Món</span>
            </a>
        </div>

        @* Kiểm tra nếu danh sách danh mục có dữ liệu thì tiến hành lặp *@
        @if (categories != null && categories.Any())
        {
            @* Lặp qua từng danh mục món ăn thu được từ CSDL *@
            foreach (var cat in categories)
            {
                <!-- Mỗi danh mục hiển thị dưới dạng một thẻ card thu nhỏ -->
                <div class="col-6 col-sm-4 col-md-2">
                    <a href="@Url.Action("Index", "Product", new { categoryId = cat.CategoryID })" class="card text-center p-3 text-decoration-none shadow-sm h-100 border-0 rounded-3 bg-white text-dark">
                        <div class="fs-2 text-danger mb-2"><i class="fa-solid fa-bowl-food"></i></div>
                        <span class="fw-bold small">@cat.CategoryName</span>
                    </a>
                </div>
            }
        }
    </div>
</div>

<!-- ========================================== -->
<!-- 3. BỘ LỌC VÀ TÌM KIẾM MÓN ĂN              -->
<!-- ========================================== -->
<!-- Khung chứa Form tìm kiếm theo từ khóa và danh mục -->
<div class="container mb-4">
    <form method="get" action="@Url.Action("Index", "Product")" class="card p-3 shadow-sm border-0 bg-white rounded-3">
        <div class="row g-3">
            <!-- Ô nhập từ khóa tên món ăn -->
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="searchString" class="form-control border-start-0 bg-light" placeholder="Nhập tên món ăn cần tìm...">
                </div>
            </div>

            <!-- Dropdown chọn danh mục cần tìm -->
            <div class="col-md-4">
                <select name="categoryId" class="form-select bg-light">
                    <option value="">-- Tất cả danh mục --</option>
                    @if (categories != null)
                    {
                        foreach (var cat in categories)
                        {
                            <option value="@cat.CategoryID">@cat.CategoryName</option>
                        }
                    }
                </select>
            </div>

            <!-- Nút bấm thực thi lệnh Tìm kiếm -->
            <div class="col-md-2">
                <button type="submit" class="btn btn-danger w-100 fw-bold">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Tìm Kiếm
                </button>
            </div>
        </div>
    </form>
</div>

<!-- ========================================== -->
<!-- 4. DANH SÁCH MÓN ĂN (GRID 3 CỘT / HÀNG)    -->
<!-- ========================================== -->
<div class="container my-4">
    <!-- Thanh tiêu đề danh sách món ăn kèm nhãn trạng thái giao hàng -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <h3 class="text-dark fw-bold m-0">
            <i class="fa-solid fa-fire-flame-curved text-danger me-2"></i>Món Ngon Nổi Bật
        </h3>
        <span class="badge bg-success fs-6"><i class="fa-solid fa-truck-fast me-1"></i>Sẵn sàng giao hàng</span>
    </div>

    <!-- Hàng chứa toàn bộ danh sách card sản phẩm món ăn -->
    <div class="row g-4">
        @* Kiểm tra nếu Mô hình Model có chứa danh sách món ăn *@
        @if (Model != null && Model.Any())
        {
            @* Lặp qua từng món ăn để đổ ra giao diện card *@
            foreach (var item in Model)
            {
                <!-- ĐÃ SỬA: Đặt col-md-4 để cố định chia đúng 3 CỘT / HÀNG trên PC/Laptop (12 / 4 = 3 món) -->
                <div class="col-12 col-sm-6 col-md-4">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden position-relative">
                        <!-- Nhãn HOT đè lên góc trên ảnh sản phẩm -->
                        <span class="position-absolute top-0 start-0 bg-danger text-white px-2 py-1 small fw-bold rounded-end mt-2" style="z-index: 5;">
                            <i class="fa-solid fa-bolt me-1"></i>HOT
                        </span>

                        <!-- Hình ảnh món ăn: Đẩy chiều cao lên 230px để hình món ăn bự, nét và ngon mắt hơn -->
                        <img src="@(!string.IsNullOrEmpty(item.ImageUrl) ? Url.Content(item.ImageUrl) : "https://via.placeholder.com/300x200?text=FoodieHub")"
                             class="card-img-top" alt="@item.ProductName" style="height: 230px; object-fit: cover;">

                        <!-- Thân card chứa thông tin chi tiết món ăn -->
                        <div class="card-body d-flex flex-column">
                            <!-- Tên món ăn hiển thị chữ bự đậm -->
                            <h5 class="card-title fw-bold text-dark mb-1" title="@item.ProductName">@item.ProductName</h5>

                            <!-- Tên danh mục phân loại món ăn -->
                            <p class="card-text text-muted small mb-2">
                                <i class="fa-solid fa-tag me-1 text-danger"></i>@(item.Category != null ? item.Category.CategoryName : "Chưa phân loại")
                            </p>

                            <!-- Khung hiển thị Giá tiền (Màu đỏ) và Số lượng tồn kho -->
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                <span class="text-danger fw-bold fs-5">@item.Price.ToString("N0") VNĐ</span>
                                <span class="badge bg-light text-dark border">Còn: @item.Stock</span>
                            </div>

                            <!-- Hàng chứa 2 nút hành động: Xem Chi Tiết và Đặt Món -->
                            <div class="d-flex gap-2 mt-3">
                                <!-- Nút chuyển sang trang Xem chi tiết sản phẩm -->
                                <a href="@Url.Action("Detail", "Product", new { id = item.ProductID })" class="btn btn-outline-secondary btn-sm flex-fill fw-bold rounded-pill">
                                    Chi tiết
                                </a>
                                <!-- Nút thêm món vào giỏ hàng -->
                                <a href="@Url.Action("AddToCart", "Cart", new { id = item.ProductID, quantity = 1 })" class="btn btn-danger btn-sm flex-fill fw-bold rounded-pill shadow-sm">
                                    <i class="fa-solid fa-cart-plus me-1"></i>Đặt Món
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Khung thông báo màu vàng xuất hiện khi chưa có món ăn nào trong CSDL -->
            <div class="col-12 text-center py-5">
                <div class="alert alert-warning py-4 shadow-sm">
                    <i class="fa-solid fa-circle-exclamation me-2 fs-4"></i>
                    <strong>Hiện tại chưa có món ăn nào sẵn sàng giao hàng!</strong>
                </div>
            </div>
        }
    </div>
</div>

<!-- ========================================== -->
<!-- 5. VÙNG CAM KẾT DỊCH VỤ KHÁCH HÀNG        -->
<!-- ========================================== -->
<div class="bg-white py-5 mt-5 border-top">
    <div class="container">
        <div class="row text-center g-4">
            <!-- Cột cam kết 1: Giao hàng hỏa tốc -->
            <div class="col-md-4">
                <div class="fs-1 text-danger mb-2"><i class="fa-solid fa-truck-fast"></i></div>
                <h5 class="fw-bold">Giao Hàng Hỏa Tốc</h5>
                <p class="text-muted small">Món ăn được giao tận tay trong vòng 20-30 phút, luôn đảm bảo nóng hổi.</p>
            </div>
            <!-- Cột cam kết 2: Vệ sinh an toàn thực phẩm -->
            <div class="col-md-4">
                <div class="fs-1 text-success mb-2"><i class="fa-solid fa-shield-halved"></i></div>
                <h5 class="fw-bold">An Toàn & Cho Sức Khỏe</h5>
                <p class="text-muted small">100% nguyên liệu tươi sạch, chế biến chuẩn vệ sinh an toàn thực phẩm.</p>
            </div>
            <!-- Cột cam kết 3: Hỗ trợ khách hàng -->
            <div class="col-md-4">
                <div class="fs-1 text-primary mb-2"><i class="fa-solid fa-headset"></i></div>
                <h5 class="fw-bold">Hỗ Trợ Khách Hàng 24/7</h5>
                <p class="text-muted small">Đội ngũ chăm sóc khách hàng tận tâm, sẵn sàng giải đáp mọi thắc mắc.</p>
            </div>
        </div>
    </div>
</div>